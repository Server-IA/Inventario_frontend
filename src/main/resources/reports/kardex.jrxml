<!-- Created with Jaspersoft Studio version 6.21.3.final using JasperReports Library version 6.21.3-4a3078d20785ebe464f18037d738d12fc98c13cf  -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Blank_A4_Landscape_1" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="342b37e0-842b-4495-845f-95acda66f152">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="agrotest-0.0.1"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="fecha_inicio" class="java.util.Date"/>
	<parameter name="fecha_fin" class="java.util.Date"/>
	<parameter name="producto_id" class="java.lang.Integer"/>
	<parameter name="unidad_id" class="java.lang.Integer"/>
	<parameter name="movimiento_id" class="java.lang.Integer"/>
	<queryString>
		<![CDATA[SELECT 
  e.emp_nombre AS header_empresa,
  s.sed_nombre AS header_sede,
  a.alm_nombre AS header_almacen,
  mun.mun_nombre AS header_municipio,
  b.blo_nombre AS header_bloque,
  es.esp_nombre AS header_espacio,
  e.emp_correo AS header_correo,
  e.emp_contacto AS header_contacto,
  e.emp_logo AS header_empresa_logo,
  CONCAT(per.per_nombre, ' ', per.per_apellido) AS header_responsable,
  p.pro_nombre AS item_producto,
  u.uni_nombre AS item_unidad,
  k.kar_fecha_hora AS item_fecha,
  k.kar_tipo_movimiento_id AS item_tipo_movimiento,
  mov.mov_nombre AS item_tipo_movimiento_nombre,
  k.kar_empresa_id AS item_cliente_proveedor,
  CASE
    WHEN tim.tim_movimiento_id = 1 THEN ki.kai_cantidad
    ELSE ki.kai_cantidad * -1
  END AS item_cantidad,
  CASE
    WHEN tim.tim_movimiento_id = 1 THEN ki.kai_cantidad * pp.prp_cantidad
    ELSE 0
  END AS item_entrada,
  CASE
    WHEN tim.tim_movimiento_id = 1 THEN 0
    ELSE ki.kai_cantidad * pp.prp_cantidad
  END AS item_salida,
  ki.kai_fecha_vencimiento AS item_fecha_vencimiento,
  (
    SELECT SUM(
      CASE
        WHEN t.tim_movimiento_id = 1 THEN i.kai_cantidad * pp2.prp_cantidad
        ELSE -1 * i.kai_cantidad * pp2.prp_cantidad
      END
    )
    FROM kardex_item i
    JOIN kardex k2 ON i.kai_kardex_id = k2.kar_id
    JOIN movimiento m2 ON m2.mov_id = k2.kar_tipo_movimiento_id
    JOIN tipo_movimiento t ON t.tim_movimiento_id = m2.mov_id
    JOIN producto_presentacion pp2 ON i.kai_producto_presentacion_id = pp2.prp_producto_id
    WHERE pp2.prp_producto_id = p.pro_id AND i.kai_id <= ki.kai_id
  ) AS item_saldo
FROM kardex k
JOIN kardex_item ki ON k.kar_id = ki.kai_kardex_id
JOIN producto_presentacion pp ON ki.kai_producto_presentacion_id = pp.prp_producto_id
JOIN producto p ON pp.prp_producto_id = p.pro_id
JOIN unidad u ON pp.prp_unidad_id = u.uni_id
JOIN almacen a ON k.kar_almacen_id = a.alm_id
JOIN espacio es ON es.esp_id = a.alm_espacio_id
JOIN bloque b ON b.blo_id = es.esp_bloque_id
JOIN sede s ON s.sed_id = b.blo_sede_id
JOIN empresa e ON s.sed_empresa_id = e.emp_id
JOIN municipio mun ON s.sed_municipio_id = mun.mun_id
JOIN persona per ON e.emp_persona_id = per.per_id
JOIN movimiento mov ON mov.mov_id = k.kar_tipo_movimiento_id
JOIN tipo_movimiento tim ON tim.tim_movimiento_id = mov.mov_id
		WHERE p.pro_id = $P{producto_id}
		  AND k.kar_tipo_movimiento_id = $P{movimiento_id}
		  AND pp.prp_unidad_id = $P{unidad_id}
		  AND k.kar_fecha_hora BETWEEN $P{fecha_inicio} AND $P{fecha_fin}
		ORDER BY ki.kai_id]]>
	</queryString>
