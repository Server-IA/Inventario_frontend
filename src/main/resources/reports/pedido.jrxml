<jasperReport name="Reporte_pedido" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" whenNoDataType="NoPages" uuid="25e1c055-c456-49cb-ba58-2e49dfeaf867">
	<style name="DetailCell" fontName="Arial" fontSize="9.0" vTextAlign="Middle">
