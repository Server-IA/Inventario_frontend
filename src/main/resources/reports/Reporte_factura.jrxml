<!-- Created with Jaspersoft Studio version 6.21.3.final using JasperReports Library version 6.21.3-4a3078d20785ebe464f18037d738d12fc98c13cf  -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Reporte_kardex" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="25e1c055-c456-49cb-ba58-2e49dfeaf867">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="agrotest-0.0.1"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="fecha_inicio" class="java.util.Date"/>
	<parameter name="fecha_fin" class="java.util.Date"/>
	<parameter name="ALM_ID" class="java.lang.Integer"/>
	<parameter name="EMP_ID" class="java.lang.Integer"/>
	<parameter name="SED_ID" class="java.lang.Integer"/>
	<parameter name="MUN_ID" class="java.lang.Integer"/>
	<parameter name="BLO_ID" class="java.lang.Integer"/>
	<parameter name="ESP_ID" class="java.lang.Integer"/>
	<parameter name="PRO_ID" class="java.lang.Integer"/>
	<parameter name="PRO_CAT_ID" class="java.lang.Integer"/>
	<queryString>
		<![CDATA[SELECT 
    e.emp_id AS header_empresa_id,
    e.emp_nombre AS header_empresa,
    s.sed_id AS header_sede_id,
    s.sed_nombre AS header_sede,
    A.alm_id AS header_almacen_id,
    al.alm_nombre AS header_almacen,
    m.mun_id AS header_municipio_id,
    m.mun_nombre AS header_municipio,
    e.emp_correo AS header_correo,
    e.emp_contacto AS header_contacto,
    e.emp_logo AS header_empresa_logo,
    CONCAT(per.per_nombre, ' ', per.per_apellido) AS header_responsable,
    esp.esp_id AS header_espacio_id,
    esp.esp_nombre AS header_espacio,
    blo.blo_id AS header_bloque_id,
    blo.blo_nombre AS header_bloque,
    p.pro_id AS item_producto_id,
    p.pro_producto_categoria_id AS item_categoria_producto_id,
    A.pro_nombre AS item_producto,
    A.uni_nombre AS item_unidad,
    A.kar_fecha_hora AS item_fecha,
    A.kar_tipo_movimiento_id AS item_tipo_movimiento,
    A.cantidad AS item_cantidad,
    A.entrada AS item_entrada,
    A.salida AS item_salida,
    ki.kai_fecha_vencimiento AS item_fecha_vencimiento,
    (SELECT SUM(B.cantidad * B.prp_cantidad) 
     FROM vista_kardex AS B 
     WHERE B.prp_producto_id = A.prp_producto_id AND B.kai_id <= A.kai_id) AS item_saldo
FROM vista_kardex AS A
JOIN kardex_item AS ki ON A.kai_id = ki.kai_id
JOIN kardex AS k ON ki.kai_kardex_id = k.kar_id
JOIN almacen AS al ON A.alm_id = al.alm_id
JOIN espacio AS esp ON al.alm_espacio_id = esp.esp_id
JOIN bloque AS blo ON esp.esp_bloque_id = blo.blo_id
JOIN sede AS s ON A.sed_id = s.sed_id
JOIN empresa AS e ON s.sed_empresa_id = e.emp_id
JOIN municipio AS m ON s.sed_municipio_id = m.mun_id
JOIN persona AS per ON e.emp_persona_id = per.per_id
JOIN producto AS p ON A.prp_producto_id = p.pro_id

WHERE 
	(CAST($P{PRO_ID} AS BIGINT) IS NULL OR p.pro_id = $P{PRO_ID}) AND
	(CAST($P{PRO_CAT_ID} AS BIGINT) IS NULL OR p.pro_id = $P{PRO_CAT_ID}) AND
    (CAST($P{EMP_ID} AS BIGINT) IS NULL OR e.emp_id = $P{EMP_ID}) AND
    (CAST($P{SED_ID} AS BIGINT) IS NULL OR s.sed_id = $P{SED_ID}) AND
    (CAST($P{MUN_ID} AS BIGINT) IS NULL OR m.mun_id = $P{MUN_ID}) AND
    (CAST($P{BLO_ID} AS BIGINT) IS NULL OR blo.blo_id = $P{BLO_ID}) AND
    (CAST($P{ESP_ID} AS BIGINT) IS NULL OR esp.esp_id = $P{ESP_ID}) AND
    (CAST($P{ALM_ID} AS BIGINT) IS NULL OR al.alm_id = $P{ALM_ID}) AND
    A.kar_fecha_hora BETWEEN $P{fecha_inicio} AND $P{fecha_fin}

ORDER BY A.kai_id]]>
	</queryString>
